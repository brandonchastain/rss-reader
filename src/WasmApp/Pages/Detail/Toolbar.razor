@using WasmApp.Services
@using RssApp.Config
@inject IJSRuntime JS
@inject IFeedClient FeedClient
@inject IPostCache PostCache
@inject ILogger<Toolbar> Logger
@inject NavigationManager NavigationManager

<div class="toolbar">

    <button class="ui-btn ui-btn--ghost ui-btn--icon" title="Check for new posts" aria-label="Check for new posts" @onclick="OnRefreshClicked" disabled="@IsRefreshing">
        <i class="fa-solid fa-rotate @(IsRefreshing ? "fa-spin" : "")" aria-hidden="true"></i>
    </button>

    <button class="ui-btn ui-btn--ghost ui-btn--icon @(IsReadingHeadlines ? "is-on" : "")"
            title="@(IsReadingHeadlines ? "Pause reading headlines" : "Read headlines aloud")"
            aria-label="@(IsReadingHeadlines ? "Pause reading headlines" : "Read headlines aloud")"
            @onclick="async () => await OnToggleReadHeadlines.InvokeAsync()">
        <i class="fa-solid @(IsReadingHeadlines ? "fa-pause" : "fa-headphones")" aria-hidden="true"></i>
    </button>

    <button class="ui-btn ui-btn--ghost @(this.IsFilterUnread ? "is-on" : "")" aria-pressed="@(this.IsFilterUnread ? "true" : "false")" @onclick="async () => {await ToggleUnreadFilterAsync.InvokeAsync(); }"><i class="fa-regular fa-envelope" aria-hidden="true"></i>unread</button>
    <button class="ui-btn ui-btn--ghost @(this.IsFilterSaved ? "is-on" : "")" aria-pressed="@(this.IsFilterSaved ? "true" : "false")" @onclick="async () => {await ToggleSavedFilterAsync.InvokeAsync(); }"><i class="fa-regular fa-bookmark" aria-hidden="true"></i>saved</button>

    <div class="dropdown-container">
        <button class="ui-btn ui-btn--ghost @(string.IsNullOrEmpty(this.FilterTag) ? "" : "is-on")" aria-expanded="@(tagsAreHidden ? "false" : "true")" @onclick="() => ToggleShowFilters()"><i class="fa-solid fa-filter" aria-hidden="true"></i>@(string.IsNullOrEmpty(this.FilterTag) ? "filters" : "#" + this.FilterTag)</button>
        <div class="filter-dropdown @(tagsAreHidden ? "" : "show")" id="filter-tags">
            @if (this.userTags != null)
            {
                @foreach (var tag in this.userTags)
                {
                    <button class="filter-tag-badge @(this.FilterTag == tag ? "active" : "")" @onclick="async () => {await FilterForTag.InvokeAsync(tag); await ToggleShowFilters();}">@tag</button>
                }
            }
        </div>
    </div>

    <button class="ui-btn ui-btn--ghost ui-btn--icon desktop-only" title="Keyboard shortcuts (?)" aria-label="Keyboard shortcuts" @onclick="ShowShortcutsAsync"><i class="fa-regular fa-keyboard" aria-hidden="true"></i></button>
</div>

@code {

    [Parameter]
    public bool IsFilterUnread { get; set; }

    [Parameter]
    public bool IsFilterSaved { get; set; }

    [Parameter]
    public string FilterTag { get; set; }

    [Parameter]
    public IEnumerable<string> userTags { get; set; }
    
    [Parameter]
    public EventCallback ToggleUnreadFilterAsync { get; set; }
    
    [Parameter]
    public EventCallback ToggleSavedFilterAsync { get; set; }
    
    [Parameter]
    public EventCallback<string> FilterForTag { get; set; }

    // Reflects an in-progress background refresh (owned by PostTable). Drives
    // the spinner without blocking the toolbar.
    [Parameter]
    public bool IsRefreshing { get; set; }

    // Fired when the user clicks refresh. PostTable kicks off a non-blocking
    // background refresh and surfaces a "new posts" toast when it finishes.
    [Parameter]
    public EventCallback OnRefreshRequested { get; set; }

    // Headline-reading mode (owned by PostTable): true while it's speaking
    // headlines top-to-bottom; the button toggles start/pause.
    [Parameter]
    public bool IsReadingHeadlines { get; set; }

    [Parameter]
    public EventCallback OnToggleReadHeadlines { get; set; }

    private bool tagsAreHidden = true;

    private async Task OnRefreshClicked()
    {
        if (IsRefreshing) return;
        await OnRefreshRequested.InvokeAsync();
    }

    private async Task ShowShortcutsAsync()
    {
        try { await JS.InvokeVoidAsync("rssApp.keys.help"); }
        catch (JSException) { }
    }

    private async Task ToggleShowFilters()
    {
        tagsAreHidden = !tagsAreHidden;
        await InvokeAsync(StateHasChanged);
    }
}