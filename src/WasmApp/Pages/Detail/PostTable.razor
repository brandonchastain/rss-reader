@inherits PageBase
@implements IDisposable
@rendermode InteractiveWebAssembly
@attribute [StreamRendering]
@attribute [Authorize]
@using System.Net
@using System.Text.RegularExpressions
@using System.Globalization
@using Microsoft.JSInterop
@using Sve.Blazor.InfiniteScroll.Components
@using WasmApp.Pages.Detail

@inject ILogger<Posts> logger
@inject IJSRuntime jsRuntime
@inject NavigationManager NavigationManager

<SectionContent SectionName="toolbar">
    <Toolbar
        filterTag="@filterTag"
        IsFilterUnread="@IsFilterUnread"
        IsFilterSaved="@IsFilterSaved"
        userTags="@userTags"
        ToggleUnreadFilterAsync="@ToggleUnreadFilterAsync"
        ToggleSavedFilterAsync="@ToggleSavedFilterAsync"
        FilterForTag="@FilterForTag"
        IsRefreshing="@_isBackgroundRefreshing"
        OnRefreshRequested="@StartBackgroundRefreshAsync"
        IsReadingHeadlines="@_isReadingHeadlines"
        OnToggleReadHeadlines="@ToggleReadHeadlinesAsync"
    />
</SectionContent>

@if (_newPostsCount > 0)
{
    <button class="new-posts-toast" @onclick="LoadNewPostsAsync">
        <i class="fas fa-arrow-up"></i>
        <span>@_newPostsCount new post@(_newPostsCount == 1 ? "" : "s") — tap to load</span>
    </button>
}
else if (_showUpToDate)
{
    <div class="new-posts-toast up-to-date">
        <i class="fas fa-check"></i>
        <span>Up to date</span>
    </div>
}

<div id="post-table" class="table">
    @if (IsLoading && (_flatEntries == null || _flatEntries.Count == 0))
    {
        <div class="loading-spinner-container">
            <div class="spinner"></div>
        </div>
    }
    else if (Posts == null || Posts.Count == 0)
    {
        <div class="no-posts-message">
            <p>No posts found.</p>
        </div>
    }
    else
    {
        @* Windowed list. Every loaded post from _windowStart on is rendered with
           a stable key; posts the reader has scrolled well past are dropped from
           the front and stand in as this spacer, sized from their measured
           heights (see rssApp.listWindow in app.js). Appends only ever add rows
           below, and the spacer only ever changes by the exact height of the rows
           it swaps with, so nothing above the viewport moves by an estimate and
           the reader's position holds. *@
        <div id="post-table-top-spacer" style="height:@(_topSpacerHeight.ToString("0.###", CultureInfo.InvariantCulture))px"></div>
        @for (int i = _windowStart; i < _flatEntries.Count; i++)
        {
            var entry = _flatEntries[i];
            @if (entry.DayKey != null)
            {
                <div @key="@entry.DayKey" class="day-separator @(entry.IsFirstHeader ? "day-separator-first" : "")">
                    <span>@GetDayLabel(entry.HeaderDate)</span>
                    @if (DayHasUnread(i))
                    {
                        var day = entry.HeaderDate;
                        <button class="link day-mark-read" title="Mark this day's loaded posts as read" @onclick="async () => await MarkDayReadAsync(day)">[mark all read]</button>
                    }
                </div>
            }
            <PostDetail @key="entry.Post.Id"
                Post="@entry.Post"
                FilterTag="@this.filterTag"/>
        }

        <InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReached="(e) => Next()">
            <div class="row">
                <div id="observerTarget">
                    RssApp
                </div>
            </div>
        </InfiniteScroll>
    }
</div>

@code {
    [CascadingParameter(Name = "Posts")]
    public List<NewsFeedItem> Posts { get; set; }
    
    [CascadingParameter(Name = "Page")]
    private int Page { get; set; }

    [CascadingParameter(Name = "IsLoading")]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    [Parameter]
    public EventCallback<(bool, bool, string, bool)> OnRefreshTriggered { get; set; }

    [Parameter]
    public IFeedClient FeedClient { get; set; }

    // Set by the timeline only. Feed, tag and search views render through this
    // same table but are narrower slices, and warming the default timeline cache
    // from one of them would be surprising.
    [Parameter]
    public bool CacheEnabled { get; set; }

    // Whether to run the idle "new posts" probe. Only the timeline's newest
    // loaded item is a valid cursor for the timeline count endpoint; on a page
    // whose rows are not the timeline (search results) the probe would report
    // every timeline item newer than the top hit, so the host turns it off.
    [Parameter]
    public bool NewPostsPollEnabled { get; set; } = true;

    public IEnumerable<string> userTags = null;
    public bool IsFilterUnread => FeedClient.IsFilterUnread;
    public bool IsFilterSaved => FeedClient.IsFilterSaved;
    private string filterTag => FeedClient.FilterTag;

    // Pre-computed flat list for the windowed loop — rebuilt only when Posts changes
    private List<TimelineEntry> _flatEntries = new();
    private int _lastPostsCount;
    private List<NewsFeedItem> _lastPosts;
    // Newest loaded (PublishDateOrder, Id) the current toast count was probed
    // against. When the head moves past it the count is for a list that is
    // gone, so the toast is dropped rather than left promising posts already
    // on screen.
    private (long order, long id)? _toastCursor;

    // Windowing state. Entries [0, _windowStart) are not in the DOM; the spacer
    // above the list is exactly as tall as they were, with each one's measured
    // height kept so it can be put back at the same size. This replaces
    // Virtualize, whose spacers were sized from a running average and whose
    // unkeyed window rebuilt every row on each shift -- together those moved the
    // content under the reader on every page load, and the browser's scroll
    // anchoring could not help because the anchored nodes no longer existed.
    private int _windowStart;
    private double _topSpacerHeight;
    private readonly List<double> _trimmedHeights = new();
    private bool _windowInitialized;

    // Rows put back per restore step as the reader scrolls up into the spacer.
    private const int RestoreBatch = 20;

    // Sentinel meaning "rebuild regardless". Zero cannot serve: a filter switch
    // empties Posts, so _lastPostsCount == Posts.Count == 0 matched the skip
    // guard and left the previous view's rows rendered -- which suppressed the
    // loading spinner and showed "No posts found" while the fetch was still
    // running.
    private const int ForceRebuild = -1;

    // Background-refresh state. The refresh runs server-side; we poll for it
    // without blocking the UI and surface a non-disruptive toast when it lands.
    private bool _isBackgroundRefreshing;
    private int _newPostsCount;
    private bool _showUpToDate;
    private CancellationTokenSource _refreshPollCts;

    // Idle "new posts available" poll. While the tab is visible and we're not
    // already refreshing/loading, periodically ask the server how many items are
    // newer than our newest-loaded post and drive the same toast. The scheduler
    // writes posts independently of user action, so without this an open timeline
    // never learns about them until a manual refresh or reload.
    // Kept short so the count climbs as the scheduler writes posts rather than
    // jumping once every minute-and-a-half; the request is a cheap COUNT probe.
    private const int NewPostsPollIntervalMs = ProbePolling.IntervalMs;
    // Delay before the next probe. Short to begin with so the toast appears
    // promptly after cache hydration, then governed by ProbePolling: exponential
    // backoff on failure, straight back to the interval on success. See that
    // class for why a fixed short retry was wrong.
    private int _probeDelayMs = ProbePolling.InitialDelayMs;
    private bool _cacheWarmed;
    private CancellationTokenSource _newPostsPollCts;

    // Headline-reading mode: speaks each post's title top-to-bottom, opening each
    // post for visual preview as it's read, chaining to the next when speech ends.
    private bool _isReadingHeadlines;
    private string _currentHeadlinePostId;
    private DotNetObjectReference<PostTable> _headlineRef;

    // DayKey is non-null only on the first post of each day; that entry renders
    // the day separator above its row.
    private record TimelineEntry(NewsFeedItem Post, DateTime HeaderDate, string DayKey, bool IsFirstHeader);

    public void Dispose()
    {
        _refreshPollCts?.Cancel();
        _refreshPollCts?.Dispose();
        _newPostsPollCts?.Cancel();
        _newPostsPollCts?.Dispose();
        try { _ = jsRuntime.InvokeVoidAsync("rssApp.listWindow.dispose"); } catch { }
        _headlineRef?.Dispose();
    }

    private async Task StartBackgroundRefreshAsync()
    {
        if (_isBackgroundRefreshing) return;

        _isBackgroundRefreshing = true;
        _showUpToDate = false;
        // Keep any existing "N new posts" toast visible while we re-check, so a
        // second click never throws away posts the user hasn't loaded yet.
        StateHasChanged();

        _refreshPollCts?.Cancel();
        _refreshPollCts = new CancellationTokenSource();
        var token = _refreshPollCts.Token;

        int newCount = 0;
        try
        {
            // Fire-and-forget on the server; it keeps running even if we stop polling.
            await FeedClient.TriggerRefreshAsync();

            // Poll progress without blocking — the user keeps reading meanwhile.
            // The server resets its count at the start of each refresh and
            // accumulates as feeds complete, so the final value is this run's total.
            const int maxSeconds = 180;
            for (int elapsed = 0; elapsed < maxSeconds && !token.IsCancellationRequested; elapsed += 2)
            {
                await Task.Delay(2000, token);
                var status = await FeedClient.GetRefreshStatusAsync();
                if (status == null) continue;
                if (status.NewItemCount > newCount) newCount = status.NewItemCount;
                if (!status.IsRefreshing) break;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Background refresh polling failed.");
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isBackgroundRefreshing = false;
                // Add this run's new posts to any still-unloaded from before.
                _newPostsCount += newCount;
                _showUpToDate = _newPostsCount == 0;
                StateHasChanged();
                if (_showUpToDate) _ = HideUpToDateSoonAsync();
            }
        }
    }

    private async Task HideUpToDateSoonAsync()
    {
        try
        {
            await Task.Delay(2500);
            _showUpToDate = false;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // best-effort auto-dismiss
        }
    }

    private async Task LoadNewPostsAsync()
    {
        // Stop any in-flight poll so it can't re-add a count for posts we're
        // about to load right now.
        _refreshPollCts?.Cancel();
        _isBackgroundRefreshing = false;
        _newPostsCount = 0;
        _showUpToDate = false;
        StateHasChanged();

        // Reuse the existing force-reset path to reload the timeline from the top.
        await OnRefreshComplete();

        try { await jsRuntime.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _headlineRef = DotNetObjectReference.Create(this);
        }

        // The JS side needs the spacer element, which only exists once the list
        // branch has rendered; hook it up on the first render that has rows.
        if (!_windowInitialized && _flatEntries.Count > 0 && _headlineRef != null)
        {
            _windowInitialized = true;
            try { await jsRuntime.InvokeVoidAsync("rssApp.listWindow.init", _headlineRef); } catch { }
        }

        if (firstRender)
        {
            // Start probing before resolving tags. GetUserTagsAsync registers the
            // user against the writer, so on a cold start it blocks for the whole
            // container wake -- awaiting it first would hold the new-posts probe
            // behind it for no reason.
            if (NewPostsPollEnabled) StartNewPostsPoll();

            await LoadUserTagsAsync();
        }
    }

    // Visibility-gated background poll for scheduler-written posts. Runs for the
    // lifetime of the component; each tick is skipped (not stopped) while the tab
    // is hidden, a manual refresh is in flight, or the timeline is still loading,
    // so it never double-counts with the manual-refresh path or fires off-screen.
    private void StartNewPostsPoll()
    {
        _newPostsPollCts?.Cancel();
        _newPostsPollCts = new CancellationTokenSource();
        var token = _newPostsPollCts.Token;
        _ = PollForNewPostsAsync(token);
    }

    private async Task PollForNewPostsAsync(CancellationToken token)
    {
        try
        {
            // Delay at the end of each iteration, not the start, so the first probe
            // fires ~one interval after the initial load settles rather than making
            // the toast invisible for a full interval after the timeline opens.
            while (!token.IsCancellationRequested)
            {
                // Skip this tick when a manual refresh owns the counter, when we're
                // still loading the initial page, or when the tab is backgrounded.
                if (!_isBackgroundRefreshing && !IsLoading)
                {
                    var cursor = GetNewestLoadedCursor();
                    if (cursor != null)
                    {
                        bool visible;
                        try { visible = await jsRuntime.InvokeAsync<bool>("isDocumentVisible"); }
                        catch { visible = true; }

                        // Nothing to surface while the tab is backgrounded, and no
                        // reason to keep waking on the short initial delay.
                        if (!visible)
                        {
                            _probeDelayMs = ProbePolling.Steady();
                        }

                        if (visible)
                        {
                            int count = -1;
                            try
                            {
                                count = await FeedClient.GetNewTimelineCountAsync(cursor.Value.order, cursor.Value.id);
                            }
                            catch (Exception ex)
                            {
                                logger.LogWarning(ex, "New-posts poll failed.");
                            }

                            // A manual refresh may have started while the request was in
                            // flight; if so, leave its counter alone. Otherwise set (not
                            // add) the absolute "new available" count so repeated ticks
                            // don't accumulate.
                            if (count >= 0)
                            {
                                _probeDelayMs = ProbePolling.Steady();

                                // A successful probe is proof the API is
                                // reachable, which makes it the natural heartbeat
                                // for replaying anything the user did while it
                                // wasn't.
                                try
                                {
                                    await FeedClient.FlushPendingWritesAsync();
                                }
                                catch (Exception ex)
                                {
                                    logger.LogWarning(ex, "Pending write flush failed.");
                                }

                                // Same signal, same reason: the API is reachable,
                                // so top the cache up to a full page. Retried on
                                // later ticks only if the attempt failed.
                                if (CacheEnabled && !_cacheWarmed)
                                {
                                    _cacheWarmed = await FeedClient.WarmTimelineCacheAsync();
                                }
                            }
                            else
                            {
                                _probeDelayMs = ProbePolling.Backoff(_probeDelayMs);
                            }

                            if (count >= 0 && !_isBackgroundRefreshing && count != _newPostsCount)
                            {
                                _newPostsCount = count;
                                _toastCursor = cursor;
                                _showUpToDate = false;
                                await InvokeAsync(StateHasChanged);
                            }
                        }
                    }
                }

                await Task.Delay(_probeDelayMs, token);
            }
        }
        catch (OperationCanceledException)
        {
            // component disposed — expected
        }
    }

    // The newest currently-loaded item's (PublishDateOrder, Id) seek position, or
    // null when nothing is loaded yet. The timeline is newest-first, but day-header
    // entries carry no post, so compute the max defensively rather than trusting
    // Posts[0].
    private (long order, long id)? GetNewestLoadedCursor()
    {
        if (Posts == null || Posts.Count == 0) return null;

        long bestOrder = long.MinValue;
        long bestId = long.MinValue;
        bool found = false;
        foreach (var post in Posts)
        {
            if (!long.TryParse(post.Id, out var id)) continue;
            var order = post.PublishDateOrder;
            if (!found || order > bestOrder || (order == bestOrder && id > bestId))
            {
                bestOrder = order;
                bestId = id;
                found = true;
            }
        }

        return found ? (bestOrder, bestId) : null;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Posts != null)
        {
            // A new list instance is a reload from the top (the reconcile over a
            // hydrated cache), which may hold exactly as many rows as before.
            if (!ReferenceEquals(Posts, _lastPosts))
            {
                _lastPosts = Posts;
                _lastPostsCount = ForceRebuild;
            }

            RebuildFlatEntries();
            DropStaleToast();
        }
    }

    private void DropStaleToast()
    {
        if (_newPostsCount == 0 || _toastCursor == null)
        {
            return;
        }

        var newest = GetNewestLoadedCursor();
        if (newest != null && newest != _toastCursor)
        {
            _newPostsCount = 0;
            _toastCursor = null;
        }
    }

    private void RebuildFlatEntries()
    {
        if (Posts == null || Posts.Count == _lastPostsCount)
            return;

        // Anything other than more posts arriving at the end -- a filter switch,
        // a reload from the top, a shrink -- invalidates the trimmed prefix.
        if (_lastPostsCount == ForceRebuild || Posts.Count < _lastPostsCount)
        {
            ResetWindow();
        }

        _lastPostsCount = Posts.Count;
        var entries = new List<TimelineEntry>(Posts.Count);
        bool isFirstGroup = true;

        foreach (var dayGroup in Posts
            .GroupBy(p => p.ParsedDate?.ToLocalTime().Date ?? DateTime.MinValue)
            .OrderByDescending(g => g.Key))
        {
            var dayKey = $"day-{dayGroup.Key:yyyy-MM-dd}";
            bool first = true;

            foreach (var post in dayGroup)
            {
                entries.Add(first
                    ? new TimelineEntry(post, dayGroup.Key, dayKey, isFirstGroup)
                    : new TimelineEntry(post, default, null, false));
                first = false;
            }

            isFirstGroup = false;
        }

        _flatEntries = entries;
        if (_windowStart > _flatEntries.Count)
        {
            ResetWindow();
        }
    }

    private void ResetWindow()
    {
        _windowStart = 0;
        _topSpacerHeight = 0;
        _trimmedHeights.Clear();
    }

    // Called from rssApp.listWindow when the viewport width changes: the
    // recorded heights were measured at the old width and would put rows back
    // at the wrong size, so render everything again and let trimming restart.
    [JSInvokable]
    public async Task RestoreAll()
    {
        if (_windowStart == 0) return;
        ResetWindow();
        await InvokeAsync(StateHasChanged);
    }

    // Called from rssApp.listWindow once the page is idle with at least a page
    // of rows more than a screen above the viewport. heights[i] is the measured
    // height of entry (_windowStart + i) including its day separator and any
    // expanded body, so the spacer grows by exactly what leaves the DOM.
    [JSInvokable]
    public async Task TrimTop(int count, double[] heights)
    {
        // Always leave at least one rendered row after the spacer: the restore
        // sentinel measures against it.
        var max = _flatEntries.Count - _windowStart - 1;
        if (count <= 0 || heights == null || heights.Length < count || max <= 0) return;
        count = Math.Min(count, max);

        for (int i = 0; i < count; i++)
        {
            _trimmedHeights.Add(heights[i]);
            _topSpacerHeight += heights[i];
        }
        _windowStart += count;

        await InvokeAsync(StateHasChanged);
    }

    // Called from rssApp.listWindow when the spacer comes within reach of the
    // viewport. Puts the most recently trimmed rows back and shrinks the spacer
    // by their recorded heights. Returns how many rows remain trimmed.
    [JSInvokable]
    public async Task<int> RestoreTop()
    {
        var k = Math.Min(RestoreBatch, _windowStart);
        for (int i = 0; i < k; i++)
        {
            var h = _trimmedHeights[_trimmedHeights.Count - 1];
            _trimmedHeights.RemoveAt(_trimmedHeights.Count - 1);
            _topSpacerHeight -= h;
        }
        _windowStart -= k;
        if (_windowStart == 0)
        {
            _topSpacerHeight = 0;
        }

        await InvokeAsync(StateHasChanged);
        return _windowStart;
    }

    // --- Mark a day read ---

    // Whether the day starting at entry index `start` has an unread post the
    // reader can see. Scans to the next day's header, so the whole list costs
    // one pass per render.
    private bool DayHasUnread(int start)
    {
        for (int i = start; i < _flatEntries.Count; i++)
        {
            if (i > start && _flatEntries[i].DayKey != null) break;
            var post = _flatEntries[i].Post;
            if (!post.IsRead && IsShown(post)) return true;
        }
        return false;
    }

    // Rows hidden by the tag filter are left alone, matching what is on screen.
    private bool IsShown(NewsFeedItem post)
        => string.IsNullOrWhiteSpace(filterTag) || post.FeedTags.Contains(filterTag);

    // Marks the loaded posts of one day read: all rows flip at once, then the
    // writes go out one by one through the same path as a single mark-read
    // (queued for replay if the API is unreachable). Posts of that day not yet
    // paged in are untouched.
    private async Task MarkDayReadAsync(DateTime day)
    {
        var posts = Posts
            .Where(p => (p.ParsedDate?.ToLocalTime().Date ?? DateTime.MinValue) == day)
            .Where(p => !p.IsRead && IsShown(p))
            .ToList();
        if (posts.Count == 0) return;

        foreach (var post in posts)
        {
            post.IsRead = true;
        }
        StateHasChanged();

        foreach (var post in posts)
        {
            try
            {
                await FeedClient.MarkAsReadAsync(post, true);
            }
            catch (Exception ex)
            {
                logger.LogWarning(ex, "Mark-read for post {PostId} failed.", post.Id);
            }
        }
    }

    private async Task ToggleUnreadFilterAsync()
    {
        _lastPostsCount = ForceRebuild;
        await this.OnRefreshTriggered.InvokeAsync((!this.IsFilterUnread, this.IsFilterSaved, this.filterTag, false));
    }

    private async Task ToggleSavedFilterAsync()
    {
        _lastPostsCount = ForceRebuild;
        await this.OnRefreshTriggered.InvokeAsync((this.IsFilterUnread, !this.IsFilterSaved, this.filterTag, false));
    }

    private async Task FilterForTag(string tag)
    {
        _lastPostsCount = ForceRebuild;
        if (this.filterTag == tag)
        {
            tag = null;
        }
        await this.OnRefreshTriggered.InvokeAsync((this.IsFilterUnread, this.IsFilterSaved, tag, false));
    }

    // Tags drive the toolbar's filter list. The cached copy paints immediately;
    // the live call behind it reconciles once the container is up.
    private async Task LoadUserTagsAsync()
    {
        await EnsureCacheIdentityAsync();

        var cached = await postCache.GetTagsAsync();
        if (cached != null && cached.Count > 0)
        {
            this.userTags = cached;
            StateHasChanged();
        }

        try
        {
            var tags = await FeedClient.GetUserTagsAsync(CurrentUser);
            if (tags != null)
            {
                this.userTags = tags;
                await postCache.SetTagsAsync(tags);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Failed to refresh user tags.");
        }
    }

    private async Task OnRefreshComplete()
    {
        _lastPostsCount = ForceRebuild;
        await this.OnRefreshTriggered.InvokeAsync((this.IsFilterUnread, this.IsFilterSaved, this.filterTag, true));
    }

    private async Task Next()
    {
        await this.OnPageChanged.InvokeAsync(this.Page + 1);
        await InvokeAsync(this.StateHasChanged);
    }

    // --- Read-headlines mode ---

    // The posts currently in the list, in display order (day-separators excluded).
    private List<NewsFeedItem> VisiblePosts()
        => _flatEntries.Where(e => e.Post != null).Select(e => e.Post).ToList();

    private async Task ToggleReadHeadlinesAsync()
    {
        if (_isReadingHeadlines)
        {
            await PauseReadingHeadlinesAsync();
        }
        else
        {
            await StartReadingHeadlinesAsync();
        }
    }

    private async Task StartReadingHeadlinesAsync()
    {
        var posts = VisiblePosts();
        if (posts.Count == 0) return;

        // Resume from the post we paused on if it's still visible; else start at the top.
        NewsFeedItem start = _currentHeadlinePostId != null
            ? posts.FirstOrDefault(p => p.Id == _currentHeadlinePostId)
            : null;
        start ??= posts[0];

        _isReadingHeadlines = true;
        StateHasChanged();
        await ReadHeadlineAsync(start);
    }

    private async Task PauseReadingHeadlinesAsync()
    {
        _isReadingHeadlines = false;
        try { await jsRuntime.InvokeVoidAsync("stopSpeaking"); } catch { }
        StateHasChanged();
    }

    private async Task ReadHeadlineAsync(NewsFeedItem post)
    {
        if (post == null) { await StopAtEndAsync(); return; }

        _currentHeadlinePostId = post.Id;

        // Open the post for visual preview and bring it into view.
        post.IsBeingPreviewed = true;
        StateHasChanged();
        try { await jsRuntime.InvokeVoidAsync("rssApp.scrollToPost", post.Id); } catch { }

        // Fill in the body in the background so the preview appears while the
        // headline is being read, without delaying the speech.
        if (post.Content == null) _ = LoadHeadlineContentAsync(post);

        // Speak the headline; OnSpeechStopped advances to the next post when it ends.
        try { await jsRuntime.InvokeVoidAsync("speakThisText", CleanTitle(post.Title), _headlineRef); }
        catch { }
    }

    private async Task LoadHeadlineContentAsync(NewsFeedItem post)
    {
        try { post.Content = await FeedClient.GetItemContentAsync(post); }
        catch { post.Content = "[content unavailable]"; }
        await InvokeAsync(StateHasChanged);
    }

    // Invoked from app.js when an utterance ends. Advances to the next headline.
    [JSInvokable]
    public async Task OnSpeechStopped()
    {
        if (!_isReadingHeadlines) return; // paused or stopped

        var posts = VisiblePosts();
        int idx = posts.FindIndex(p => p.Id == _currentHeadlinePostId);

        // Collapse the post we just read so only the current one stays open.
        if (idx >= 0) posts[idx].IsBeingPreviewed = false;

        var next = (idx >= 0 && idx + 1 < posts.Count) ? posts[idx + 1] : null;
        if (next == null) { await StopAtEndAsync(); return; }

        await ReadHeadlineAsync(next);
    }

    private async Task StopAtEndAsync()
    {
        _isReadingHeadlines = false;
        _currentHeadlinePostId = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string CleanTitle(string title)
    {
        if (string.IsNullOrEmpty(title)) return title;
        var cleaned = Regex.Replace(title, "<[^>]+>", string.Empty);
        return WebUtility.HtmlDecode(cleaned);
    }

    private static readonly string[] _months = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    private static readonly string[] _days = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };

    private static string GetDayLabel(DateTime date)
    {
        if (date == DateTime.MinValue) return "Unknown date";
        return $"{_days[(int)date.DayOfWeek]}, {_months[date.Month - 1]} {date.Day} {date.Year}";
    }
}