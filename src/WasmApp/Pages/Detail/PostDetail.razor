@using System.Threading.Tasks
@using System.Net
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@using RssApp.Config
@inherits PageBase
@implements IDisposable

@rendermode InteractiveWebAssembly
@attribute [StreamRendering]
@attribute [Authorize]

@inject IJSRuntime jsRuntime
@inject NavigationManager navigationManager
@inject RssWasmConfig Config

@if (Post != null)
{
<div @ref="_postRowRef" data-post-id="@Post.Id" class="row @(Post.IsRead ? "post-read" : "post-unread")" @onclick="async () => await HandleClick(Post)" hidden=@(ShouldPostBeHidden(Post))>
    <div class="col thumbnail">
        @{
            var thumbnailUrl = Post.ThumbnailUrl;
            var faviconUrl = FaviconUrl(Post);
        }
        <div class="thumb">
        @if (!String.IsNullOrWhiteSpace(thumbnailUrl))
        {
            // Article image, cropped to the frame. If it fails to load, show the
            // site favicon small in the frame instead; if that fails too, the
            // frame is left empty (the placeholder is hidden by CSS).
            <img src="@thumbnailUrl" alt="" class="thumb-img" loading="lazy" decoding="async"
                 onerror="this.onerror=function(){this.onerror=null;this.className='thumb-img thumb-placeholder';this.src='/placeholder.jpg'};this.className='thumb-img thumb-favicon';this.src='@faviconUrl'" />
        }
        else
        {
            // No article image; the site favicon sits small in the frame.
            <img src="@faviconUrl" alt="" class="thumb-img thumb-favicon" loading="lazy" decoding="async"
                 onerror="this.onerror=null;this.className='thumb-img thumb-placeholder';this.src='/placeholder.jpg'" />
        }
        </div>
    </div>
    <div class="col post-body">
        <p class="post-title">
            @foreach (var tag in Post.FeedTags)
            {
                <span class="post-tag">@tag</span>
            }
            <a tooltip="@FormatDate(Post.ParsedDate)" href="@Post.Href" data-article-link data-post-id="@Post.Id" data-mark-read-url="/api/item/markAsRead?itemId=@Post.Id&isRead=true" @onclick:stopPropagation="true" @onclick="() => OnArticleLinkClick(Post)">@CleanTitle(Post.Title)</a>
        </p>
        <div class="post-actions">
            <button class="link" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="async () => await MarkAsReadAsync(Post, !Post.IsRead)">[mark @(!Post.IsRead ? "read" : "unread")]</button><button class="link" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="async () => await SavePost(Post)">[@(!Post.IsSaved ? "save" : "unsave")]</button>
            @if (!String.IsNullOrWhiteSpace(Post.CommentsHref))
            {
                <a class="link" href="@Post.CommentsHref" data-article-link data-post-id="@Post.Id" @onclick:stopPropagation="true">[comments]</a>
            }
            <a class="post-domain" href="/posts?href=@System.Net.WebUtility.UrlEncode(Post.FeedUrl)" @onclick:stopPropagation="true">@Post.Href.GetRootDomain()</a>
        </div>
    </div>
</div>
@if (Post.IsBeingPreviewed)
{
<div class="postContent">
    <div class="">
        <p>
            Published on @FormatDate(Post.ParsedDate)
        </p>
        @if (_isLoadingContent)
        {
            <p><em>Loading content…</em></p>
        }
        else
        {
            <p>
                @if (_isSpeaking)
                {
                    <button class="link" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => StopSpeaking()"><i class="fa-solid fa-stop"></i> [stop speaking]</button>
                }
                else
                {
                    <button class="link" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => OnSpeakTextClicked(Post)"><i class="fa-solid fa-volume-high"></i> [speak this text]</button>
                }
            </p>
            @if (ShouldShowHero(Post))
            {
                <figure class="post-hero"><img src="@Post.GetThumbnailUrl()" alt="" loading="lazy" decoding="async" /></figure>
            }
            <p>
                @((MarkupString)HtmlSanitizer.Sanitize(Post.Content ?? ""))
            </p>
        }
        <p>
            <button class="btn-link" @onclick="async () => await HandleClick(Post)">Collapse</button>
        </p>
    </div>
</div>
}
}

@code {
    [Parameter]
    public NewsFeedItem Post { get; set; }

    [Parameter]
    public string FilterTag { get; set; }

    [Parameter]
    public bool IsFilterUnread { get; set; }

    private bool _isSpeaking = false;
    private bool _isLoadingContent = false;
    private DotNetObjectReference<PostDetail> _dotNetRef;
    private ElementReference _postRowRef;

    private static string CleanTitle(string title)
    {
        if (string.IsNullOrEmpty(title)) return title;
        var cleaned = Regex.Replace(title, "<[^>]+>", string.Empty);
        return WebUtility.HtmlDecode(cleaned);
    }

    // Content that opens with an image (optionally wrapped in a link, paragraph
    // or figure) already has its own lead image.
    private static readonly Regex LeadsWithImage = new(
        @"^(?:\s*<(?:p|div|figure|a|picture|span|center)\b[^>]*>)*\s*<img\b",
        RegexOptions.IgnoreCase | RegexOptions.Compiled);

    // Show the article image above the body unless the body already carries it:
    // either the same URL appears in the content, or the content leads with an
    // image of its own (typically a smaller rendition of the same picture, now
    // that the server stores the largest one the feed offers).
    private static bool ShouldShowHero(NewsFeedItem post)
    {
        var url = post?.GetThumbnailUrl();
        if (string.IsNullOrWhiteSpace(url) || post.Content == null) return false;

        var content = post.Content.TrimStart();
        if (content.IndexOf(url, StringComparison.OrdinalIgnoreCase) >= 0) return false;

        return !LeadsWithImage.IsMatch(content);
    }

    // Per-domain favicon served from our own origin (GET /api/feed/icon). Resolve
    // against ApiBaseUrl so it works both in prod (relative, "" -> "/api/...") and
    // when the API lives on a different origin in local dev.
    private string FaviconUrl(NewsFeedItem post)
    {
        var domain = post.Href.GetRootDomain();
        var baseUrl = string.IsNullOrEmpty(Config.ApiBaseUrl) ? "/" : Config.ApiBaseUrl;
        return $"{baseUrl}api/feed/icon?domain={WebUtility.UrlEncode(domain)}";
    }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    [JSInvokable]
    public void OnSpeechStopped()
    {
        _isSpeaking = false;
        InvokeAsync(StateHasChanged);
    }

    private static string StripHtml(string html)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s{2,}", " ");
        return System.Net.WebUtility.HtmlDecode(text).Trim();
    }

    private async Task OnSpeakTextClicked(NewsFeedItem post)
    {
        if (post?.Content != null)
        {
            _isSpeaking = true;
            await jsRuntime.InvokeVoidAsync("speakThisText", StripHtml(post.Content), _dotNetRef);
        }
    }

    private async Task StopSpeaking()
    {
        _isSpeaking = false;
        await jsRuntime.InvokeVoidAsync("stopSpeaking");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private void OnArticleLinkClick(NewsFeedItem post)
    {
        // Optimistic UI update only. Scroll-state save and mark-as-read are
        // handled synchronously by the document-level capture-phase click
        // listener in app.js (see saveScrollStateForLink + the data-article-link
        // delegate). The browser then navigates naturally via the link's href.
        post.IsRead = true;
    }

    private async Task OnCommentsLinkClick(string commentsHref)
    {
        // Kept for backward compatibility — current markup no longer wires this up.
        try
        {
            await jsRuntime.InvokeVoidAsync("rssApp.saveScrollStateAndNavigate", Post.Id, commentsHref);
        }
        catch (TaskCanceledException) { }
        catch (JSException) { }
    }

    private bool ShouldPostBeHidden(NewsFeedItem post)
    {
        bool isFilteredByTag = !string.IsNullOrWhiteSpace(this.FilterTag) && !post.FeedTags.Contains(this.FilterTag);
        bool isFilteredByUnread = !post.IsBeingPreviewed && this.IsFilterUnread && post.IsRead;
        return isFilteredByTag || isFilteredByUnread;
    }

    private async Task MarkAsReadAsync(NewsFeedItem item, bool isRead)
    {
        if (isRead && !item.IsRead)
        {
            item.IsRead = true;
        }
        else if (!isRead && item.IsRead)
        {
            item.IsRead = false;
        }

        await InvokeAsync(StateHasChanged);
        try
        {
            await this.feedClient.MarkAsReadAsync(item, item.IsRead);
        }
        catch (Exception)
        {
            // Best-effort — don't crash the UI if the backend is busy (e.g. during refresh).
            // The read state is already updated locally, and FeedClient queues the
            // change when the API doesn't accept it, so it reaches the server on
            // the next successful probe rather than being lost.
        }
    }

    private async Task PreviewPostAsync(NewsFeedItem post)
    {
        bool wasExpanded = post.IsBeingPreviewed;
        if (wasExpanded)
        {
            // Scroll the post row to the top of the viewport BEFORE collapsing.
            // This ensures the content collapses below the fold so the infinite-scroll
            // sentinel never enters the viewport during the DOM shrink.
            await jsRuntime.InvokeVoidAsync("scrollToTopInstant", _postRowRef);
        }

        post.IsBeingPreviewed = !post.IsBeingPreviewed;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SavePost(NewsFeedItem post)
    {
        if (!post.IsSaved)
        {
            post.IsSaved = true;
            await InvokeAsync(StateHasChanged);
            await this.feedClient.SavePostAsync(post);
        }
        else    
        {
            post.IsSaved = false;
            await InvokeAsync(StateHasChanged);
            await this.feedClient.UnsavePostAsync(post);
        }
    }

    private static readonly string[] _months = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    private static readonly string[] _days = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };

    private static string FormatDate(DateTime? date)
    {
        if (date == null) return "";
        var d = date.Value;
        return $"{_days[(int)d.DayOfWeek]}, {_months[d.Month - 1]} {d.Day} {d.Year} {d:h:mm tt}";
    }

    private async Task HandleClick(NewsFeedItem post, bool preview = true)
    {
        if (!preview || _isLoadingContent) return;

        // Update read state immediately in the UI, then fire the API call
        // without blocking content loading. During feed refresh, MarkAsRead
        // competes for the SQLite write lock and can hang for seconds.
        _ = MarkAsReadAsync(post, true);

        // Lazy-load content on first expand
        if (!post.IsBeingPreviewed && post.Content == null)
        {
            post.IsBeingPreviewed = true;
            _isLoadingContent = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                post.Content = await feedClient.GetItemContentAsync(post);
            }
            catch (Exception)
            {
                post.Content = "[content unavailable]";
            }

            _isLoadingContent = false;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            await PreviewPostAsync(post);
        }
    }
}