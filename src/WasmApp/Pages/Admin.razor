@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using RssApp.Contracts
@using WasmApp.Services
@attribute [Authorize]

@inject IAdminClient adminClient
@inject IUserClient userClient
@inject IJSRuntime JS
@inject NavigationManager navigationManager

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Admin Dashboard</h1>
        @if (!loading && isAdmin)
        {
            <button type="button" class="refresh-btn" disabled="@refreshing" @onclick="RefreshNowAsync" title="Take a fresh snapshot now">
                @(refreshing ? "Refreshing�" : "Refresh now")
            </button>
        }
    </div>

    @if (loading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (!isAdmin)
    {
        <p class="text-muted">Access denied.</p>
    }
    else
    {
        @* Stats Cards *@
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Users</div>
                <div class="stat-value">@(current?.UserCount.ToString("N0") ?? "—")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Feeds</div>
                <div class="stat-value">@(current?.FeedCount.ToString("N0") ?? "—")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Posts</div>
                <div class="stat-value">@(current?.ItemCount.ToString("N0") ?? "—")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">DB Size</div>
                <div class="stat-value">@FormatBytes(current?.DbSizeBytes ?? 0)</div>
            </div>
        </div>

        @if (current != null)
        {
            <p class="snapshot-timestamp">
                Last snapshot: @current.Timestamp.ToLocalTime().ToString("g")
            </p>
        }

        @* Chart *@
        <div class="chart-section">
            <div class="section-header">
                <h2 class="section-title">Trends (@RangeLabel(range))</h2>
                <div class="range-switch" role="group" aria-label="Trend range">
                    @foreach (var key in RangeOptions)
                    {
                        var r = key;
                        <button type="button"
                                class="range-btn @(r == range ? "active" : "")"
                                aria-pressed="@(r == range ? "true" : "false")"
                                disabled="@historyLoading"
                                @onclick="() => SetRangeAsync(r)">@r</button>
                    }
                </div>
            </div>
            @if (history.Count > 1)
            {
                <div class="chart-wrapper">
                    <canvas id="admin-stats-chart"></canvas>
                </div>
            }
            else
            {
                <p class="text-muted">
                    Not enough snapshots in this range yet. Snapshots are taken hourly and whenever you press Refresh now.
                </p>
            }
        </div>

        @* Users *@
        <div class="chart-section">
            <h2 class="section-title">Registered Users</h2>
            @if (users.Count > 0)
            {
                <table class="users-table">
                    <thead>
                        <tr><th>ID</th><th>Username</th><th>Feeds</th><th>Posts</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr><td>@u.Id</td><td>@u.Username</td><td>@u.FeedCount.ToString("N0")</td><td>@u.PostCount.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No users found.</p>
            }
        </div>

        @if (error != null)
        {
            <div class="admin-error mt-3">@error</div>
        }
    }
</div>

@code {
    private bool loading = true;
    private bool isAdmin = false;
    private SystemStatsSnapshot current;
    private List<SystemStatsSnapshot> history = new();
    private static readonly string[] RangeOptions = { "1h", "1d", "7d", "30d", "1y" };
    private string range = "30d";
    private bool historyLoading;
    private bool refreshing;
    private List<AdminUser> users = new();
    private string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await userClient.GetFeedUserAsync();
            isAdmin = user?.IsAdmin ?? false;

            if (!isAdmin)
            {
                navigationManager.NavigateTo("/timeline");
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load admin data: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading && isAdmin && history.Count > 1)
        {
            await RenderChartAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            current = await adminClient.GetCurrentStatsAsync();
            history = await adminClient.GetStatsHistoryAsync(range);
            users = await adminClient.GetUsersAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to refresh stats: {ex.Message}";
        }
    }

    private async Task RefreshNowAsync()
    {
        if (refreshing) return;
        refreshing = true;
        try
        {
            // A forced snapshot, then the chart and user table catch up to it.
            current = await adminClient.RefreshStatsAsync();
            history = await adminClient.GetStatsHistoryAsync(range);
            users = await adminClient.GetUsersAsync();
            error = null;
        }
        catch (Exception ex)
        {
            error = $"Refresh failed: {ex.Message}";
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task SetRangeAsync(string key)
    {
        if (key == range || historyLoading) return;
        historyLoading = true;
        try
        {
            history = await adminClient.GetStatsHistoryAsync(key);
            range = key;
            error = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to load {RangeLabel(key)} of history: {ex.Message}";
        }
        finally
        {
            historyLoading = false;
        }
        // OnAfterRenderAsync redraws the chart from the new history.
    }

    private static string RangeLabel(string key) => key switch
    {
        "1h" => "1 hour",
        "1d" => "24 hours",
        "7d" => "7 days",
        "30d" => "30 days",
        "1y" => "1 year",
        _ => key,
    };

    // Denser ranges need the time; longer ones only the date.
    private static string LabelFormat(string key) => key switch
    {
        "1h" => "HH:mm:ss",
        "1d" => "HH:mm",
        "7d" => "MM/dd HH:mm",
        "30d" => "MM/dd",
        _ => "yyyy-MM-dd",
    };

    private async Task RenderChartAsync()
    {
        try
        {
            var format = LabelFormat(range);
            var labels = history
                .Select(s => s.Timestamp.ToLocalTime().ToString(format))
                .ToArray();

            var datasets = new object[]
            {
                new {
                    label = "Feeds",
                    data = history.Select(s => s.FeedCount).ToArray(),
                    borderColor = "#3fb950",
                    backgroundColor = "rgba(63,185,80,0.1)"
                },
                new {
                    label = "Posts",
                    data = history.Select(s => s.ItemCount).ToArray(),
                    borderColor = "#79b8ff",
                    backgroundColor = "rgba(121,184,255,0.1)"
                },
                new {
                    label = "Users",
                    data = history.Select(s => s.UserCount).ToArray(),
                    borderColor = "#e3b341",
                    backgroundColor = "rgba(227,179,65,0.1)"
                }
            };

            await JS.InvokeVoidAsync("AdminChart.render", "admin-stats-chart", labels, datasets);
        }
        catch (Exception ex)
        {
            error = $"Chart render error: {ex.Message}";
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F1} GB";
        if (bytes >= 1_048_576)     return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1_024)         return $"{bytes / 1_024.0:F1} KB";
        return $"{bytes} B";
    }
}
