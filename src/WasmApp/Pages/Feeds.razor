@page "/feeds"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO
@using Microsoft.AspNetCore.Components.Sections
@using RssApp.RssClient
@using RssApp.Serialization
@using WasmApp.Pages.Base
@using RssApp.Contracts

@inherits PageBase
@attribute [StreamRendering]
@attribute [Authorize]
@inject ILogger<Feeds> logger
@inject IJSRuntime jsRuntime
@inject NavigationManager navigation
@rendermode InteractiveWebAssembly

<PageTitle>Feeds</PageTitle>
<SectionContent SectionName="page-title">Feeds</SectionContent>

<div class="feeds-tabs" role="tablist">
    <a role="tab" class="feeds-tab @TabClass("subscriptions")" href="feeds" aria-selected="@(CurrentTab == "subscriptions")">
        My feeds @if (feeds != null)
        {
            <span class="feeds-tab-count">@feeds.Count()</span>
        }
    </a>
    <a role="tab" class="feeds-tab @TabClass("popular")" href="feeds?tab=popular" aria-selected="@(CurrentTab == "popular")">Popular</a>
    <a role="tab" class="feeds-tab @TabClass("add")" href="feeds?tab=add" aria-selected="@(CurrentTab == "add")">Add a feed</a>
    <a role="tab" class="feeds-tab @TabClass("transfer")" href="feeds?tab=transfer" aria-selected="@(CurrentTab == "transfer")">Import / Export</a>
</div>

@if (lastError != null)
{
    <p class="feeds-error" role="alert">@lastError</p>
}

@if (CurrentTab == "add")
{
    <section class="feeds-panel">
        <h2 class="feeds-section-title">Subscribe to a feed</h2>
        <p class="feeds-section-hint">Paste the address of a blog or site feed (RSS or Atom). New posts will show up in your timeline.</p>
        <form method="post" @onsubmit="SubmitAsync" @formname="newfeed">
            <AntiforgeryToken />
            <div class="feeds-form-row">
                <InputText @bind-Value="NewFeedUrl" placeholder="https://example.com/feed.rss" class="feeds-url-input" aria-label="Feed address" />
                <button type="submit" class="btn btn-primary">Subscribe</button>
            </div>
        </form>
        <p class="feeds-section-hint">Looking for ideas? See the <a href="feeds?tab=popular">popular feeds</a>.</p>
    </section>
}
else if (CurrentTab == "transfer")
{
    <section class="feeds-panel">
        <h2 class="feeds-section-title">Move your subscriptions</h2>
        <p class="feeds-section-hint">OPML is the standard file format other feed readers use. Tags are included.</p>
        <div class="feeds-form-row">
            <button type="button" class="btn btn-secondary" @onclick="ExportOpml">Export OPML</button>
            <InputFile OnChange="ImportOpml" accept=".opml,.xml" id="opmlImportInput" hidden />
            <label for="opmlImportInput" class="btn btn-secondary">Import OPML</label>
        </div>
    </section>
}
else if (CurrentTab == "popular")
{
    @if (popularFeeds == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <p class="feeds-section-hint">The most followed feeds on RSS Reader.</p>
        @if (!popularFeeds.Any())
        {
            <p class="feeds-section-hint" id="popular-feeds-empty">Nothing here yet.</p>
        }
        <div id="popular-feeds">
            @foreach (var popular in popularFeeds)
            {
                <div class="feeds-row feeds-popular-row">
                    <div class="feeds-row-main">
                        <span class="feeds-row-title">@DisplayName(popular.Title, popular.Href)</span>
                        <span class="feeds-row-sub">@HostOf(popular.Href) · @popular.SubscriberCount @(popular.SubscriberCount == 1 ? "subscriber" : "subscribers")</span>
                    </div>
                    @if (IsSubscribed(popular.Href))
                    {
                        <span class="feeds-popular-count feeds-subscribe-btn">Subscribed</span>
                    }
                    else
                    {
                        <button class="btn btn-secondary feeds-subscribe-btn" disabled="@subscribing.Contains(popular.Href)" @onclick="() => SubscribePopularAsync(popular)">Subscribe</button>
                    }
                </div>
            }
        </div>
    }
}
else if (feeds == null)
{
    <p><em>Loading...</em></p>
}
else if (!feeds.Any())
{
    <p class="feeds-section-hint">You are not subscribed to anything yet. <a href="feeds?tab=add">Add a feed</a> or pick from the <a href="feeds?tab=popular">popular feeds</a>.</p>
}
else
{
    <div id="post-table">
        @foreach (NewsFeed feed in feeds.OrderBy(f => DisplayName(f.Title, f.Href), StringComparer.OrdinalIgnoreCase))
        {
            <div class="feeds-row" @onclick="() => ToggleFeed(feed.Href)">
                <div class="feeds-row-main">
                    <span class="feeds-row-title">@DisplayName(feed.Title, feed.Href)</span>
                    <span class="feeds-row-sub">
                        @HostOf(feed.Href)
                        @if (feed.IsFailing)
                        {
                            <span class="feeds-health-badge" title="@FailureSummary(feed)">not updating</span>
                        }
                    </span>
                </div>
                <div class="feeds-row-tags" @onclick:stopPropagation="true">
                    @if (feed.Tags != null)
                    {
                        @foreach (var tag in feed.Tags)
                        {
                            <span class="feeds-tag-chip">
                                <span class="post-tag">@tag</span><button type="button" class="feeds-tag-remove" title="Remove tag @tag" aria-label="Remove tag @tag" @onclick="() => RemoveTagAsync(feed, tag)">&times;</button>
                            </span>
                        }
                    }
                    <input type="text"
                        class="feeds-tag-input"
                        value="@newTagInputs[feed.Href]"
                        placeholder="+ tag"
                        aria-label="Add a tag to @DisplayName(feed.Title, feed.Href)"
                        @oninput="e => HandleTagInput(feed, e.Value.ToString())"
                        @onkeydown="e => HandleTagKeyDown(e, feed)"
                        @onkeydown:stopPropagation="true" />
                </div>
                <div class="feeds-row-actions" @onclick:stopPropagation="true">
                    <a href="posts?Href=@System.Net.WebUtility.UrlEncode(feed.Href)" class="feeds-row-link">View posts</a>
                    @if (confirmUnsubscribe == feed.Href)
                    {
                        <button class="feeds-delete-btn" @onclick="() => DeleteAsync(feed.Href)">Confirm</button>
                        <button class="feeds-cancel-btn" @onclick="() => confirmUnsubscribe = null">Cancel</button>
                    }
                    else
                    {
                        <button class="feeds-delete-btn" @onclick="() => confirmUnsubscribe = feed.Href">Unsubscribe</button>
                    }
                </div>
            </div>
            <div class="feeds-expanded" hidden=@(openFeed != feed.Href)>
                <div class="col">
                    Feed URL: @feed.Href
                </div>
                @if (feed.ConsecutiveFailures > 0)
                {
                    <div class="col feeds-health-detail">
                        @FailureSummary(feed)
                    </div>
                }
            </div>
        }
    </div>
    <p class="feeds-section-hint">Tip: type a tag and press Space or Enter. Tags group feeds in your timeline filter; hide a tag from the <a href="tags">Tags</a> page.</p>
}

@code {
    private static string FailureSummary(NewsFeed feed)
    {
        var error = string.IsNullOrWhiteSpace(feed.LastError) ? "unknown error" : feed.LastError;
        var last = feed.LastFetchedUtc.HasValue
            ? $", last tried {feed.LastFetchedUtc.Value.ToLocalTime():g}"
            : string.Empty;
        return $"Last {feed.ConsecutiveFailures} fetch{(feed.ConsecutiveFailures == 1 ? "" : "es")} failed: {error}{last}. If the feed moved, unsubscribe and add its new address.";
    }

    private static string HostOf(string href)
        => Uri.TryCreate(href, UriKind.Absolute, out var uri) ? uri.Host : href;

    private static string DisplayName(string title, string href)
        => !string.IsNullOrWhiteSpace(title) ? title : Uri.TryCreate(href, UriKind.Absolute, out var uri) ? uri.Host : href;

    [SupplyParameterFromQuery(Name = "tab")]
    private string Tab { get; set; }

    private string CurrentTab => Tab switch
    {
        "popular" => "popular",
        "add" => "add",
        "transfer" => "transfer",
        _ => "subscriptions",
    };

    private string TabClass(string tab) => CurrentTab == tab ? "active" : string.Empty;

    private string confirmUnsubscribe = null;
    private string openFeed = null;
    private Dictionary<string, string> newTagInputs = new Dictionary<string, string>();
    private IEnumerable<NewsFeed> feeds;
    private string lastError = null;
    private IEnumerable<PopularFeed> popularFeeds;
    private readonly HashSet<string> subscribing = new HashSet<string>();

    [SupplyParameterFromForm]
    private string NewFeedUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        feeds = await this.GetFeedUrls();
        await LoadPopularAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            feeds = await this.GetFeedUrls();
            await LoadPopularAsync();
            this.StateHasChanged();
        }
    }

    private void ToggleFeed(string feedHref)
    {
        if (openFeed == feedHref)
        {
            openFeed = null;
        }
        else
        {
            openFeed = feedHref;
        }
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        try
        {
            lastError = null;
            if (string.IsNullOrWhiteSpace(NewFeedUrl))
            {
                lastError = "Feed URL is empty";
                return;
            }

            NewFeedUrl = NewFeedUrl.Trim();

            if (NewFeedUrl.StartsWith("http://"))
            {
                NewFeedUrl = NewFeedUrl.Replace("http://", "https://");
            }
            else if (!NewFeedUrl.StartsWith("https://"))
            {
                NewFeedUrl = "https://" + NewFeedUrl;
            }

            await this.feedClient.AddFeedAsync(new NewsFeed(NewFeedUrl, userId: -1));
            NewFeedUrl = string.Empty;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            lastError = ex.Message;
            this.logger.LogWarning("The server refused feed {url}: {reason}", NewFeedUrl, ex.Message);
            return;
        }
        catch (HttpRequestException ex)
        {
            lastError = "Invalid feed URL.";
            this.logger.LogError(ex, "Invalid feed url, got HTTP exception from {url}", NewFeedUrl);
            return;
        }
        catch (Exception ex)
        {
            lastError = "Could not add feed.";
            this.logger.LogError(ex, "Could not add feed {url}", NewFeedUrl);
            return;
        }

        await this.OnInitializedAsync();
        navigation.NavigateTo("feeds");
    }

    private async Task DeleteAsync(string feed)
    {
        confirmUnsubscribe = null;
        await this.feedClient.DeleteFeedAsync(feed);
        await this.OnInitializedAsync();
    }

    private bool IsSubscribed(string href)
        => feeds != null && feeds.Any(f => string.Equals(f.Href, href, StringComparison.OrdinalIgnoreCase));

    private async Task SubscribePopularAsync(PopularFeed popular)
    {
        if (!subscribing.Add(popular.Href)) return;
        try
        {
            await this.feedClient.AddFeedAsync(new NewsFeed(popular.Href, userId: -1));
        }
        catch (Exception ex)
        {
            lastError = "Could not subscribe to that feed.";
            this.logger.LogError(ex, "Could not subscribe to popular feed {url}", popular.Href);
        }
        finally
        {
            subscribing.Remove(popular.Href);
        }

        await this.OnInitializedAsync();
    }

    private async Task LoadPopularAsync()
    {
        try
        {
            popularFeeds = await this.feedClient.GetPopularFeedsAsync();
        }
        catch (Exception ex)
        {
            // Discovery is optional; the page works without it.
            this.logger.LogWarning(ex, "Could not load popular feeds");
        }
    }

    private async Task<IEnumerable<NewsFeed>> GetFeedUrls()
    {
        var result = await this.feedClient.GetFeedsAsync();
        foreach (var feed in result)
        {
            if (!newTagInputs.ContainsKey(feed.Href))
                newTagInputs[feed.Href] = string.Empty;
        }
        return result;
    }

    private async Task HandleTagKeyDown(KeyboardEventArgs e, NewsFeed feed)
    {
        if (e.Key == "Enter")
            await AddTag(feed);
    }

    private async Task HandleTagInput(NewsFeed feed, string value)
    {
        if (value.EndsWith(" "))
        {
            newTagInputs[feed.Href] = value.TrimEnd();
            await AddTag(feed);
            return;
        }
        newTagInputs[feed.Href] = value;
    }

    private async Task AddTag(NewsFeed feed)
    {
        if (!newTagInputs.ContainsKey(feed.Href) || string.IsNullOrWhiteSpace(newTagInputs[feed.Href]))
        {
            this.logger.LogWarning("Tag input is empty for feed {Href}", feed.Href);
            return;
        }

        var tag = newTagInputs[feed.Href];
        await this.feedClient.AddTagAsync(feed, tag);
        newTagInputs[feed.Href] = string.Empty;
        this.OnInitialized();
    }

    private async Task RemoveTagAsync(NewsFeed feed, string tag)
    {
        try
        {
            await this.feedClient.RemoveTagAsync(feed, tag);
            feed.Tags?.Remove(tag);
        }
        catch (Exception ex)
        {
            lastError = "Could not remove that tag.";
            logger.LogError(ex, "Could not remove tag {tag} from {url}", tag, feed.Href);
        }
    }

    private async Task ExportOpml()
    {
        var opmlContent = await this.feedClient.ExportOpmlAsync();

        if (string.IsNullOrWhiteSpace(opmlContent))
        {
            this.logger.LogWarning("No feeds to export to OPML.");
            return;
        }

        await jsRuntime.InvokeVoidAsync("downloadFile", "feeds.opml", "application/xml", opmlContent);
    }

    private async Task ImportOpml(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null)
            {
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB max size
            using var reader = new StreamReader(stream);
            var opmlContent = await reader.ReadToEndAsync();
            await this.feedClient.ImportOpmlAsync(opmlContent);
            await this.OnInitializedAsync();
            navigation.NavigateTo("feeds");
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error importing OPML file");
            lastError = "Could not import that file.";
        }
    }
}
