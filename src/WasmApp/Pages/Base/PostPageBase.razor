@using RssApp.Contracts
@inherits PageBase
@implements IDisposable
@inject ILogger<PostPageBase> logger
@inject IJSRuntime jsRuntime
@inject NavigationManager NavigationManager

@code {
    private bool _isRefreshing;
    // The most recent request that arrived while a fetch was in flight. Holding
    // the whole request rather than a bool matters: filter toggles arrive with
    // forceReset false, so the old flag discarded them outright and a filter
    // click during a slow load did nothing at all -- leaving the toolbar looking
    // dead with navigation as the only way out.
    private (bool isFilterUnread, bool isFilterSaved, string filterTag, bool forceReset)? _pendingRequest;
    private bool _hasLoadedOnce;
    private string _scrollAnchorPostId;
    private bool _needsScrollRestore;
    private int _restorePageSize;
    private int _lastPrefetchedCount;
    public List<NewsFeedItem> Items { get; set; } = new List<NewsFeedItem>();
    public int Page { get; set; } = 0;
    public long? CursorPublishDateOrder { get; set; }
    public long? CursorId { get; set; }
    protected bool initialized = false;

    public bool IsLoading => !_hasLoadedOnce || _isRefreshing;

    protected class ScrollState
    {
        public string PostId { get; set; }
        public int Page { get; set; }
        public string Path { get; set; }
    }

    public void Dispose()
    {
        this.Items.Clear();
    }

    protected virtual string GetBasePath() => "/timeline";

    // Only the main timeline caches. Feed, search and tag views are narrower
    // slices whose cached contents would be misleading to paint as the timeline,
    // and they aren't what a cold start opens on.
    protected virtual bool SupportsCache => false;

    // Every filter view caches separately. Read/saved state stays consistent
    // across slots because a mark-read patches all of them and the outbox
    // overlays anything the server hasn't accepted yet -- without those, a cached
    // 'unread' view would resurface posts already read.
    private bool CacheApplies => SupportsCache;

    // Cache slot for the filters currently in effect.
    private string CacheSignature => PostCache.SignatureFor(
        this.feedClient.IsFilterUnread, this.feedClient.IsFilterSaved, this.feedClient.FilterTag);
    protected virtual Dictionary<string, string> GetExtraQueryParams() => new();

    protected virtual Task<List<NewsFeedItem>> GetPostsAsync(int pageSize = 20)
    {
        // overridden
        throw new NotImplementedException();
    }

    protected void ResetPagination()
    {
        Items.Clear();
        Page = 0;
        CursorPublishDateOrder = null;
        CursorId = null;
        _lastPrefetchedCount = 0;
    }

    protected void UpdateCursorFromItems(IEnumerable<NewsFeedItem> items)
    {
        var lastItem = items.LastOrDefault();
        if (lastItem != null && long.TryParse(lastItem.Id, out var parsedId))
        {
            CursorPublishDateOrder = lastItem.PublishDateOrder;
            CursorId = parsedId;
        }
    }

    protected async Task UpdatePage(int page)
    {
        if (!initialized || _isRefreshing)
        {
            return;
        }

        Page = page;
        await this.RefreshItems((this.feedClient.IsFilterUnread, this.feedClient.IsFilterSaved, this.feedClient.FilterTag, false));
    }

    protected async Task RefreshItems((bool isFilterUnread, bool isFilterSaved, string filterTag, bool forceReset) filters)
    {
        if (_isRefreshing)
        {
            // Last request wins -- toggling twice should land on what the reader
            // asked for last, not replay both.
            _pendingRequest = filters;
            return;
        }

        try
        {
            _isRefreshing = true;

            bool forceReset = filters.forceReset;

            bool filtersChanged = UpdateFilters(
                (filters.isFilterUnread, filters.isFilterSaved, filters.filterTag));

            if (forceReset || filtersChanged)
            {
                ResetPagination();
                if (filtersChanged) UpdateUrlFromFilters();
            }

            int pageSize = _restorePageSize > 0 ? _restorePageSize : 20;
            _restorePageSize = 0;

            List<NewsFeedItem> newPageRes = null;
            try
            {
                newPageRes = await this.GetPostsAsync(pageSize);
            }
            catch (Exception ex)
            {
                // The API is unreachable or still waking. Keep whatever is on
                // screen -- possibly a hydrated cache -- instead of tearing it
                // down, and don't let the exception escape into the infinite
                // scroll handler. Deliberately not an early return: that would
                // skip the pending-request drain below, stranding a filter click
                // that arrived during the failed fetch.
                logger.LogWarning(ex, "Timeline fetch failed; keeping the current items.");
            }

            if (newPageRes != null)
            {
                // Overlay changes the server hasn't accepted yet: a page fetched
                // before the outbox drains would otherwise show the server's older
                // flags and visibly revert what the user just did.
                await ApplyPendingWritesAsync(newPageRes);

                // Deduplicate by Href before adding
                var existingHrefs = new HashSet<string>(Items.Select(i => i.Href), StringComparer.OrdinalIgnoreCase);
                var dedupedNewPosts = newPageRes.Where(i => !existingHrefs.Contains(i.Href)).ToList();
                Items.AddRange(dedupedNewPosts);

                // Update cursor from the new page results (not deduplicated — use original to get true last item)
                if (newPageRes.Any())
                {
                    UpdateCursorFromItems(newPageRes);
                }

                // Sync loaded item count to JS for scroll-state save estimation
                try { await jsRuntime.InvokeVoidAsync("rssApp.setLoadedItemCount", Items.Count); } catch { }

                // Persist after every load, not just the first. Items is ordered
                // newest-first and paging only appends older posts, so the head
                // stays the true newest -- and gating this on the first load
                // alone capped the cache at one page.
                if (Items.Count > 0)
                {
                    await PersistTimelineCacheAsync();
                }
            }

            this.StateHasChanged();
        }
        finally
        {
            _isRefreshing = false;
            _hasLoadedOnce = true;
        }

        // Apply whatever arrived while we were busy. Runs after a failed fetch
        // too, so an unreachable API delays a filter change rather than losing it.
        if (_pendingRequest is { } pending)
        {
            _pendingRequest = null;
            await RefreshItems(pending);
        }
    }

    private bool UpdateFilters((bool isFilterUnread, bool isFilterSaved, string filterTag) filters)
    {
        bool hasChanged = filters.isFilterUnread != this.feedClient.IsFilterUnread
            || filters.isFilterSaved != this.feedClient.IsFilterSaved
            || filters.filterTag != this.feedClient.FilterTag;

        if (hasChanged)
        {
            this.feedClient.IsFilterUnread = filters.isFilterUnread;
            this.feedClient.IsFilterSaved = filters.isFilterSaved;
            this.feedClient.FilterTag = filters.filterTag;
        }

        return hasChanged;
    }

    protected void ApplyFiltersFromUrl()
    {
        var qs = ParseQueryString(NavigationManager.Uri);
        this.feedClient.IsFilterUnread = qs.TryGetValue("unread", out var u) && u == "true";
        this.feedClient.IsFilterSaved = qs.TryGetValue("saved", out var s) && s == "true";
        this.feedClient.FilterTag = qs.TryGetValue("tag", out var t) ? t : null;
    }

    protected void UpdateUrlFromFilters()
    {
        var queryParams = new Dictionary<string, string>();
        if (feedClient.IsFilterUnread) queryParams["unread"] = "true";
        if (feedClient.IsFilterSaved) queryParams["saved"] = "true";
        if (!string.IsNullOrEmpty(feedClient.FilterTag)) queryParams["tag"] = feedClient.FilterTag;

        foreach (var kv in GetExtraQueryParams())
            if (!string.IsNullOrEmpty(kv.Value))
                queryParams[kv.Key] = kv.Value;

        var path = GetBasePath();
        var url = queryParams.Count > 0
            ? path + "?" + string.Join("&", queryParams.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"))
            : path;

        var currentRelative = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var currentPath = currentRelative.Contains('?') ? currentRelative[..currentRelative.IndexOf('?')] : currentRelative;
        var newPath = url.Contains('?') ? url[..url.IndexOf('?')] : url;

        // Only navigate if something actually changed (compare full normalized URLs)
        var currentQs = ParseQueryString(NavigationManager.Uri);
        var newQs = ParseQueryString("http://x" + url);
        if (currentPath != newPath || !QueryParamsEqual(currentQs, newQs))
        {
            NavigationManager.NavigateTo(url, replace: true);
        }
    }

    // Applies queued read/saved changes to freshly fetched items. Safe to call
    // for any view: with no cache identity the queue reads back empty.
    private async Task ApplyPendingWritesAsync(IEnumerable<NewsFeedItem> items)
    {
        try
        {
            var pending = await this.postCache.GetPendingWritesAsync();
            PendingWrites.Apply(pending, items);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Could not apply pending writes to fetched items.");
        }
    }

    // Fills Items from the browser cache so the timeline is readable while the
    // container wakes. Returns false (leaving Items untouched) on any miss.
    private async Task<bool> TryHydrateFromCacheAsync()
    {
        if (!CacheApplies)
        {
            return false;
        }

        try
        {
            var username = await EnsureCacheIdentityAsync();
            if (string.IsNullOrEmpty(username))
            {
                return false;
            }

            var cached = await this.postCache.GetTimelineAsync(CacheSignature);
            if (cached == null || cached.Count == 0)
            {
                return false;
            }

            Items.Clear();
            Items.AddRange(cached);

            // Seek from the oldest cached item so scrolling continues past the
            // cached window instead of re-fetching it. The server ignores the
            // page offset whenever a cursor is supplied.
            UpdateCursorFromItems(cached);

            _hasLoadedOnce = true;
            this.StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Timeline cache hydration failed; loading from the API.");
            return false;
        }
    }

    // Stores the newest page of items and prefetches their bodies in one request,
    // so the next cold start opens on posts that can actually be read rather than
    // a list of titles. Best-effort and never blocks the render.
    private async Task PersistTimelineCacheAsync()
    {
        if (!CacheApplies)
        {
            return;
        }

        try
        {
            var username = await EnsureCacheIdentityAsync();
            if (string.IsNullOrEmpty(username))
            {
                return;
            }

            var head = Items.Take(PostCache.MaxTimelineItems).ToList();
            await this.postCache.SetTimelineAsync(CacheSignature, head);

            // Only prefetch as the cached head grows, so paging through the
            // timeline doesn't re-request bodies that are already stored.
            if (head.Count > _lastPrefetchedCount)
            {
                _lastPrefetchedCount = head.Count;
                _ = this.feedClient.PrefetchContentAsync(head.Select(i => i.Id));
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Failed to persist the timeline cache.");
        }
    }

    private static bool QueryParamsEqual(Dictionary<string, string> a, Dictionary<string, string> b)
    {
        if (a.Count != b.Count) return false;
        foreach (var kv in a)
        {
            if (!b.TryGetValue(kv.Key, out var val) || val != kv.Value) return false;
        }
        return true;
    }

    private static Dictionary<string, string> ParseQueryString(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var qIndex = uri.IndexOf('?');
        if (qIndex < 0) return result;
        var query = uri[(qIndex + 1)..];
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eqIndex = pair.IndexOf('=');
            if (eqIndex > 0)
                result[Uri.UnescapeDataString(pair[..eqIndex])] = Uri.UnescapeDataString(pair[(eqIndex + 1)..]);
        }
        return result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            this.initialized = true;

            // Apply filter state from URL query parameters
            ApplyFiltersFromUrl();

            // Check for scroll restoration from sessionStorage
            try
            {
                var scrollState = await jsRuntime.InvokeAsync<ScrollState>("rssApp.getScrollState");
                if (scrollState != null && scrollState.Path == GetBasePath())
                {
                    _scrollAnchorPostId = scrollState.PostId;
                    _needsScrollRestore = true;
                    _restorePageSize = Math.Min((scrollState.Page + 2) * 20, 500);
                    await jsRuntime.InvokeVoidAsync("rssApp.clearScrollState");
                }
            }
            catch (Exception)
            {
                // sessionStorage may be unavailable
            }

            // Paint the previous session's timeline before touching the API. A
            // scroll restore is skipped deliberately: it only happens on
            // in-session back-navigation, when the container is already warm, and
            // its larger page size would fight the cached head.
            if (!_needsScrollRestore)
            {
                await TryHydrateFromCacheAsync();
            }

            // Hydration leaves Items populated, which by design suppresses the
            // initial fetch -- PostTable's existing new-posts poll probes the
            // server instead and surfaces the toast when the container wakes.
            if (this.Items == null || !this.Items.Any())
            {
                await this.RefreshItems((this.feedClient.IsFilterUnread, this.feedClient.IsFilterSaved, this.feedClient.FilterTag, false));
            }
        }
        else if (_needsScrollRestore && !string.IsNullOrEmpty(_scrollAnchorPostId))
        {
            try
            {
                // All items are always in the DOM (no Virtualize), so scrollToPost
                // will find the element on the first attempt after items are loaded.
                var scrolled = await jsRuntime.InvokeAsync<bool>("rssApp.scrollToPost", _scrollAnchorPostId);
                if (scrolled || Items.Any(i => i.Id == _scrollAnchorPostId))
                {
                    _needsScrollRestore = false;
                    _scrollAnchorPostId = null;
                }
                // else: items not yet loaded — try again next render cycle
            }
            catch (Exception)
            {
                _needsScrollRestore = false;
            }
        }
    }
}
