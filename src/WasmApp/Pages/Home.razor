@page "/"
@page "/index"
@using WasmApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager NavigationManager
@inject ILogger<Index> logger
@inject IUserClient userClient
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthClient AuthClient

<PageTitle>RssReader | A simple browser-based RSS reader</PageTitle>

<article @ref="_terminalRef" tabindex="0" @onkeydown="HandleKeyDown" style="outline: none;">
    <div class="shell-boot">
        <div class="shell-line shell-cmd">$ rssreader --connect</div>
        <div class="shell-banner">
            <span><span class="comment-slash">// </span><span class="comment-text">rssreader [v1.1]</span></span>
            <span><span class="comment-slash">// </span><span class="comment-text">read what matters to you.</span></span>
            <span><span class="comment-slash">// </span><span class="comment-text">your feeds, clean and readable, everywhere.</span></span>
        </div>
        <div class="shell-line"><span class="shell-prompt">&gt;</span> Initializing</div>
        <div class="shell-line"><span class="shell-prompt">&gt;</span> Loading configuration...</div>
        <div class="shell-line"><span class="shell-prompt">&gt;</span> Connected.</div>
        <div class="shell-line" style="margin-top: 1rem;"><span class="shell-prompt">&gt;</span> subscribe to RSS and Atom feeds</div>
        <div class="shell-line"><span class="shell-prompt">&gt;</span> infinite-scroll timeline</div>
        <div class="shell-line"><span class="shell-prompt">&gt;</span> save posts for later</div>
        <div class="shell-line"><span class="shell-prompt">&gt;</span> works on phone and desktop</div>
        <div class="shell-line desktop-only"><span class="shell-prompt">&gt;</span> vim-style keys: j / k to move, l to read, ? for the rest</div>
        <AuthorizeView>
            <NotAuthorized>
                @if (_providers == null)
                {
                    <div class="shell-line" style="margin-top: 1.5rem;"><span class="shell-prompt">&gt;</span> Checking login providers...</div>
                }
                else if (_providers.Count == 0)
                {
                    <div class="shell-line" style="margin-top: 1.5rem;"><span class="shell-prompt">&gt;</span> No login provider is configured on the API.</div>
                }
                else if (!_showChooser && _providers.Count == 1)
                {
                    @* Say who the sign-in is with before ENTER leaves the page for it. *@
                    <div class="shell-line" style="margin-top: 1.5rem;"><span class="shell-prompt">&gt;</span> [auth] @ProviderLabel(_providers[0]) sign-in required to sync your feeds</div>
                    @* Desktop: keyboard prompt *@
                    <div class="shell-line shell-cmd desktop-only" style="margin-top: 0.5rem;">$ press [ENTER] to sign in with @ProviderLabel(_providers[0])<span class="shell-cursor">█</span></div>
                    @* Mobile: button *@
                    <div class="mobile-only" style="margin-top: 0.75rem;">
                        <a href="@LoginUrl(_providers[0])" class="btn btn-outline-success btn-sm" style="font-family: inherit; letter-spacing: 0.05em;">Sign in with @ProviderLabel(_providers[0])</a>
                    </div>
                }
                else
                {
                    <div class="shell-line shell-cmd desktop-only" style="margin-top: 1.5rem;">$ rssreader --login<span class="shell-cursor">█</span></div>
                    <div class="shell-line" style="margin-top: 0.5rem;"><span class="shell-prompt">&gt;</span> sign in with</div>
                    <div class="login-providers">
                        @foreach (var provider in _providers)
                        {
                            <a href="@LoginUrl(provider)" class="btn btn-outline-success btn-sm" style="font-family: inherit; letter-spacing: 0.05em;">@ProviderLabel(provider)</a>
                        }
                    </div>
                }
            </NotAuthorized>
        </AuthorizeView>
    </div>
</article>

@code {
    // Auto-focus for keyboard handling; FocusAsync runs after first render
    private ElementReference _terminalRef;
    private string _returnUrl;

    private IReadOnlyList<string> _providers;
    private bool _showChooser;

    // The API validates returnUrl against its allowed frontend origins, so an
    // absolute URL on this origin is what it expects. Default: the timeline.
    private string LoginUrl(string provider)
    {
        var returnUrl = string.IsNullOrEmpty(_returnUrl)
            ? NavigationManager.ToAbsoluteUri("/timeline").ToString()
            : NavigationManager.ToAbsoluteUri(_returnUrl).ToString();
        return AuthClient.LoginUrl(provider, returnUrl);
    }

    private static string ProviderLabel(string provider) => provider switch
    {
        "google" => "Google",
        "microsoft" => "Microsoft",
        "github" => "GitHub",
        _ => provider,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Redirect authenticated users to timeline without a full page reload
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo("/timeline", replace: true);
                return;
            }

            // Read returnUrl from query string (set by RedirectToLogin for deep links)
            var uri = new Uri(NavigationManager.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            _returnUrl = query["returnUrl"];

            await _terminalRef.FocusAsync();
            _providers = await AuthClient.GetProvidersAsync();
            StateHasChanged();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _providers == null || _providers.Count == 0)
            return;

        if (_providers.Count == 1)
        {
            NavigationManager.NavigateTo(LoginUrl(_providers[0]), forceLoad: true);
        }
        else
        {
            _showChooser = true;
        }
    }
}